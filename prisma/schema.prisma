generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CLOSED
}

enum MediaStatus {
  ACTIVE
  ARCHIVED
}

enum LeadType {
  GENERAL
  PROJECT
  SUPPLIER
  PARTNER
  COMPLIANCE
}

enum LeadStatus {
  NEW
  QUALIFYING
  CONTACTED
  PROPOSAL
  WON
  LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PortalTenantType {
  CLIENT
  SUPPLIER
}

enum PortalAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum PortalMembershipRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum PortalTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PortalProjectStatus {
  INTAKE
  PLANNING
  QUOTING
  APPROVAL
  DELIVERY
  COMPLETED
  ON_HOLD
}

enum PortalDocumentVisibility {
  TENANT
  NEXUS_ONLY
  SHARED
}

enum PortalDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}

enum PortalQuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  VERIFIED
  BLOCKED
  NOT_APPLICABLE
}

enum PartnerVerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  SUSPENDED
}

enum InternalTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

model AdminUser {
  id                       String                      @id @default(cuid())
  email                    String                      @unique
  name                     String?
  passwordHash             String
  role                     String                      @default("EDITOR")
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  auditLogs                AuditLog[]
  mediaAssets              MediaAsset[]
  publications             CmsPublication[]
  sectionTemplates         CmsSectionTemplate[]
  assignedLeads            BusinessLead[]              @relation("LeadOwner")
  leadActivities           LeadActivity[]
  costVersions             CostAssumptionVersion[]
  timelineVersions         TimelineAssumptionVersion[]
  portalDocumentsVerified  PortalDocument[]            @relation("PortalDocumentVerifier")
  portalQuotationsCreated  PortalQuotation[]           @relation("PortalQuotationCreator")
  portalComments           PortalComment[]             @relation("PortalAdminComment")
  portalAuditEvents        PortalAuditEvent[]          @relation("PortalAdminAudit")
  supplierProfilesVerified Supplier[]                  @relation("SupplierVerifier")
  phase5ProjectsOwned      PortalProject[]             @relation("Phase5ProjectOwner")
  complianceResponsible    ComplianceRecord[]          @relation("ComplianceResponsible")
  partnersVerified         LocalPartner[]              @relation("PartnerVerifier")
  phase5TasksAssigned      InternalTask[]              @relation("TaskAssignee")
  phase5TasksCreated       InternalTask[]              @relation("TaskCreator")
}

model CmsPage {
  id                String           @id @default(cuid())
  slug              String           @unique
  pageType          String           @default("STANDARD")
  status            ContentStatus    @default(DRAFT)
  labelEn           String
  labelZh           String
  labelFr           String
  seoTitleEn        String
  seoTitleZh        String
  seoTitleFr        String
  seoDescriptionEn  String           @db.Text
  seoDescriptionZh  String           @db.Text
  seoDescriptionFr  String           @db.Text
  publishedSnapshot Json?
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sections          CmsSection[]
  publications      CmsPublication[]
  mediaReferences   MediaReference[]

  @@index([status])
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  key       String
  type      String
  position  Int
  enabled   Boolean  @default(true)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
  @@unique([pageId, position])
  @@index([pageId, position])
}

model CmsPublication {
  id                   String           @id @default(cuid())
  pageId               String
  version              Int
  snapshot             Json
  note                 String?          @db.Text
  publishedById        String?
  sourcePublicationId  String?
  createdAt            DateTime         @default(now())
  page                 CmsPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  publishedBy          AdminUser?       @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  sourcePublication    CmsPublication?  @relation("PublicationRollback", fields: [sourcePublicationId], references: [id], onDelete: SetNull)
  rollbackPublications CmsPublication[] @relation("PublicationRollback")
  mediaReferences      MediaReference[]

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model CmsSectionTemplate {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?    @db.Text
  sectionType String
  content     Json
  system      Boolean    @default(false)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sectionType])
}

model MediaAsset {
  id              String           @id @default(cuid())
  url             String           @unique
  downloadUrl     String?
  pathname        String           @unique
  originalName    String
  contentType     String
  sizeBytes       Int
  width           Int?
  height          Int?
  altEn           String
  altZh           String
  altFr           String
  storageProvider String
  etag            String?
  status          MediaStatus      @default(ACTIVE)
  createdById     String?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  references      MediaReference[]

  @@index([status, createdAt])
  @@index([contentType])
}

model MediaReference {
  id            String          @id @default(cuid())
  assetId       String
  pageId        String
  publicationId String?
  source        String
  sectionKey    String
  fieldPath     String
  createdAt     DateTime        @default(now())
  asset         MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  page          CmsPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  publication   CmsPublication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([assetId, source])
  @@index([pageId, source])
  @@index([publicationId])
}

model AuditLog {
  id           String     @id @default(cuid())
  actorAdminId String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  actorAdmin   AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorAdminId, createdAt])
  @@index([entityType, entityId])
}

model RateLimitBucket {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  sku             String?          @unique
  titleEn         String
  titleZh         String
  titleFr         String
  descriptionEn   String           @db.Text
  descriptionZh   String           @db.Text
  descriptionFr   String           @db.Text
  category        String
  coverImage      String?
  gallery         Json?
  specifications  Json?
  featured        Boolean          @default(false)
  status          ContentStatus    @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  portalDocuments PortalDocument[]
}

model Project {
  id         String        @id @default(cuid())
  slug       String        @unique
  titleEn    String
  titleZh    String
  titleFr    String
  summaryEn  String        @db.Text
  summaryZh  String        @db.Text
  summaryFr  String        @db.Text
  industry   String
  country    String?
  region     String?
  coverImage String?
  gallery    Json?
  concept    Boolean       @default(true)
  featured   Boolean       @default(false)
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model NewsPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  titleEn     String
  titleZh     String
  titleFr     String
  excerptEn   String        @db.Text
  excerptZh   String        @db.Text
  excerptFr   String        @db.Text
  contentEn   String        @db.Text
  contentZh   String        @db.Text
  contentFr   String        @db.Text
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Supplier {
  id                 String           @id @default(cuid())
  companyName        String
  contactName        String?
  email              String?
  phone              String?
  country            String?
  productTypes       String?
  certifications     String?
  notes              String?          @db.Text
  approved           Boolean          @default(false)
  portalTenantId     String?          @unique
  verificationStatus String           @default("UNVERIFIED")
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  portalTenant       PortalTenant?    @relation(fields: [portalTenantId], references: [id], onDelete: SetNull)
  verifiedBy         AdminUser?       @relation("SupplierVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  portalDocuments    PortalDocument[]

  @@index([verificationStatus])
  @@index([verifiedByAdminId])
}

model Inquiry {
  id                 String        @id @default(cuid())
  name               String
  email              String
  phone              String?
  company            String?
  country            String?
  interest           String?
  message            String        @db.Text
  locale             String        @default("en")
  consent            Boolean       @default(false)
  consentAt          DateTime?
  consentTextVersion String?
  status             InquiryStatus @default(NEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model BusinessLead {
  id                 String          @id @default(cuid())
  organizationKey    String          @default("nexus")
  reference          String          @unique
  type               LeadType        @default(PROJECT)
  status             LeadStatus      @default(NEW)
  priority           LeadPriority    @default(NORMAL)
  locale             String          @default("en")
  contactName        String
  contactEmail       String
  contactPhone       String?
  organizationName   String?
  country            String?
  province           String?
  municipality       String?
  sector             String?
  projectType        String?
  intendedUse        String?
  sizeCapacity       String?
  budgetRange        String?
  targetTimeline     String?
  siteReadiness      String?
  complianceNeeds    String?
  notes              String?         @db.Text
  consent            Boolean
  consentAt          DateTime?
  consentTextVersion String?
  source             String          @default("WEBSITE")
  sourceMetadata     Json?
  ownerAdminId       String?
  nextAction         String?         @db.Text
  dueDate            DateTime?
  portalProjectId    String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  owner              AdminUser?      @relation("LeadOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  activities         LeadActivity[]
  estimates          SavedEstimate[]
  emailMessages      EmailOutbox[]
  portalProject      PortalProject?  @relation(fields: [portalProjectId], references: [id], onDelete: SetNull)
  internalTasks      InternalTask[]

  @@index([organizationKey, createdAt])
  @@index([organizationKey, status, priority])
  @@index([organizationKey, type])
  @@index([ownerAdminId, status])
  @@index([organizationKey, dueDate])
  @@index([contactEmail])
}

model LeadActivity {
  id              String       @id @default(cuid())
  organizationKey String       @default("nexus")
  leadId          String
  actorAdminId    String?
  kind            String
  body            String?      @db.Text
  metadata        Json?
  createdAt       DateTime     @default(now())
  lead            BusinessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorAdmin      AdminUser?   @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([organizationKey, leadId, createdAt])
  @@index([actorAdminId, createdAt])
}

model CostAssumptionVersion {
  id              String          @id @default(cuid())
  organizationKey String          @default("nexus")
  version         Int
  name            String
  currency        String          @default("CAD")
  assumptions     Json
  disclaimerEn    String          @db.Text
  disclaimerZh    String          @db.Text
  disclaimerFr    String          @db.Text
  active          Boolean         @default(false)
  createdById     String?
  createdAt       DateTime        @default(now())
  createdBy       AdminUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  estimates       SavedEstimate[]

  @@unique([organizationKey, version])
  @@index([organizationKey, active])
}

model TimelineAssumptionVersion {
  id              String          @id @default(cuid())
  organizationKey String          @default("nexus")
  version         Int
  name            String
  stages          Json
  uncertaintyPct  Int             @default(20)
  disclaimerEn    String          @db.Text
  disclaimerZh    String          @db.Text
  disclaimerFr    String          @db.Text
  active          Boolean         @default(false)
  createdById     String?
  createdAt       DateTime        @default(now())
  createdBy       AdminUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  estimates       SavedEstimate[]

  @@unique([organizationKey, version])
  @@index([organizationKey, active])
}

model SavedEstimate {
  id                      String                     @id @default(cuid())
  organizationKey         String                     @default("nexus")
  reference               String                     @unique
  leadId                  String?
  locale                  String                     @default("en")
  input                   Json
  costResult              Json?
  timelineResult          Json?
  costAssumptionVersionId String?
  timelineVersionId       String?
  createdAt               DateTime                   @default(now())
  lead                    BusinessLead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  costAssumptionVersion   CostAssumptionVersion?     @relation(fields: [costAssumptionVersionId], references: [id], onDelete: Restrict)
  timelineVersion         TimelineAssumptionVersion? @relation(fields: [timelineVersionId], references: [id], onDelete: Restrict)

  @@index([organizationKey, createdAt])
  @@index([leadId, createdAt])
  @@index([costAssumptionVersionId])
  @@index([timelineVersionId])
}

model EmailOutbox {
  id                String            @id @default(cuid())
  organizationKey   String            @default("nexus")
  leadId            String?
  internalTaskId    String?
  dedupeKey         String            @unique
  templateKey       String
  locale            String            @default("en")
  recipient         String
  replyTo           String?
  subject           String
  textBody          String            @db.Text
  htmlBody          String            @db.Text
  status            EmailOutboxStatus @default(PENDING)
  attempts          Int               @default(0)
  maxAttempts       Int               @default(5)
  nextAttemptAt     DateTime          @default(now())
  lockedAt          DateTime?
  sentAt            DateTime?
  lastError         String?           @db.Text
  providerMessageId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lead              BusinessLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  internalTask      InternalTask?     @relation(fields: [internalTaskId], references: [id], onDelete: SetNull)

  @@index([organizationKey, status, nextAttemptAt])
  @@index([leadId, createdAt])
  @@index([internalTaskId, createdAt])
}

model PortalTenant {
  id              String             @id @default(cuid())
  organizationKey String             @default("nexus")
  slug            String             @unique
  name            String
  type            PortalTenantType
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  memberships     PortalMembership[]
  projects        PortalProject[]
  documents       PortalDocument[]
  quotations      PortalQuotation[]
  comments        PortalComment[]
  auditEvents     PortalAuditEvent[]
  supplier        Supplier?

  @@index([organizationKey, type, active])
}

model PortalUser {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String
  passwordHash      String
  locale            String              @default("en")
  status            PortalAccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  memberships       PortalMembership[]
  sessions          PortalSession[]
  authTokens        PortalAuthToken[]
  documentsUploaded PortalDocument[]    @relation("PortalDocumentUploader")
  comments          PortalComment[]     @relation("PortalUserComment")
  auditEvents       PortalAuditEvent[]  @relation("PortalUserAudit")

  @@index([status, createdAt])
}

model PortalMembership {
  id             String                @id @default(cuid())
  tenantId       String
  userId         String
  role           PortalMembershipRole  @default(MEMBER)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         PortalTenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           PortalUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteDecisions PortalQuoteDecision[]

  @@unique([tenantId, userId])
  @@index([userId, active])
  @@index([tenantId, role, active])
}

model PortalSession {
  id         String     @id @default(cuid())
  userId     String
  tokenHash  String     @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  user       PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model PortalAuthToken {
  id        String          @id @default(cuid())
  userId    String
  kind      PortalTokenKind
  tokenHash String          @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  user      PortalUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt])
}

model PortalProject {
  id                String              @id @default(cuid())
  tenantId          String
  reference         String
  title             String
  description       String?             @db.Text
  status            PortalProjectStatus @default(INTAKE)
  ownerAdminId      String?
  priority          LeadPriority        @default(NORMAL)
  nextAction        String?             @db.Text
  dueDate           DateTime?
  budgetAmount      Decimal?            @db.Decimal(14, 2)
  contractedAmount  Decimal?            @db.Decimal(14, 2)
  invoicedAmount    Decimal?            @db.Decimal(14, 2)
  paidAmount        Decimal?            @db.Decimal(14, 2)
  currency          String              @default("CAD")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            PortalTenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents         PortalDocument[]
  quotations        PortalQuotation[]
  comments          PortalComment[]
  owner             AdminUser?          @relation("Phase5ProjectOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  linkedLead        BusinessLead?
  complianceRecords ComplianceRecord[]
  internalTasks     InternalTask[]

  @@unique([tenantId, reference])
  @@index([tenantId, status, updatedAt])
  @@index([ownerAdminId, status, dueDate])
}

model PortalDocument {
  id                 String                   @id @default(cuid())
  tenantId           String
  projectId          String?
  uploaderId         String?
  verifiedByAdminId  String?
  supplierId         String?
  productId          String?
  name               String
  pathname           String                   @unique
  url                String                   @unique
  contentType        String
  sizeBytes          Int
  category           String
  visibility         PortalDocumentVisibility @default(TENANT)
  status             PortalDocumentStatus     @default(PENDING)
  checksum           String?
  libraryPublishedAt DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             PortalTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project            PortalProject?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader           PortalUser?              @relation("PortalDocumentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  verifiedBy         AdminUser?               @relation("PortalDocumentVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  supplier           Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product            Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  complianceEvidence ComplianceRecord[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, projectId, visibility])
  @@index([supplierId, libraryPublishedAt])
  @@index([productId, libraryPublishedAt])
}

model ComplianceRecord {
  id                 String           @id @default(cuid())
  organizationKey    String           @default("nexus")
  projectId          String?
  evidenceDocumentId String?
  responsibleAdminId String?
  jurisdiction       String
  projectUse         String
  category           String
  requirement        String           @db.Text
  status             ComplianceStatus @default(NOT_STARTED)
  responsibleParty   String?
  evidenceUrl        String?
  reviewDate         DateTime?
  publicVisible      Boolean          @default(false)
  publicTitleEn      String?
  publicTitleZh      String?
  publicTitleFr      String?
  publicSummaryEn    String?          @db.Text
  publicSummaryZh    String?          @db.Text
  publicSummaryFr    String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  project            PortalProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  evidenceDocument   PortalDocument?  @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  responsibleAdmin   AdminUser?       @relation("ComplianceResponsible", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  internalTasks      InternalTask[]

  @@index([organizationKey, jurisdiction, status])
  @@index([projectId, category])
  @@index([publicVisible, jurisdiction])
  @@index([responsibleAdminId, reviewDate])
}

model LocalPartner {
  id                 String                    @id @default(cuid())
  organizationKey    String                    @default("nexus")
  name               String
  category           String
  region             String
  capabilities       String                    @db.Text
  verificationStatus PartnerVerificationStatus @default(UNVERIFIED)
  contactName        String?
  email              String?
  phone              String?
  website            String?
  contactVisible     Boolean                   @default(false)
  active             Boolean                   @default(true)
  notes              String?                   @db.Text
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  verifiedBy         AdminUser?                @relation("PartnerVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  @@index([organizationKey, category, region])
  @@index([verificationStatus, active])
}

model InternalTask {
  id                 String             @id @default(cuid())
  organizationKey    String             @default("nexus")
  title              String
  description        String?            @db.Text
  status             InternalTaskStatus @default(OPEN)
  priority           LeadPriority       @default(NORMAL)
  dueDate            DateTime?
  leadId             String?
  projectId          String?
  complianceRecordId String?
  assigneeAdminId    String?
  createdByAdminId   String?
  reminderSentAt     DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lead               BusinessLead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  project            PortalProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  complianceRecord   ComplianceRecord?  @relation(fields: [complianceRecordId], references: [id], onDelete: SetNull)
  assignee           AdminUser?         @relation("TaskAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
  createdBy          AdminUser?         @relation("TaskCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  emailMessages      EmailOutbox[]

  @@index([organizationKey, status, priority])
  @@index([assigneeAdminId, status, dueDate])
  @@index([leadId, createdAt])
  @@index([projectId, createdAt])
  @@index([complianceRecordId, createdAt])
}

model PortalQuotation {
  id               String                @id @default(cuid())
  tenantId         String
  projectId        String
  createdByAdminId String?
  number           String
  version          Int
  title            String
  currency         String                @default("CAD")
  totalAmount      Decimal?              @db.Decimal(14, 2)
  lineItems        Json
  assumptions      Json?
  exclusions       Json?
  status           PortalQuotationStatus @default(DRAFT)
  validUntil       DateTime?
  sentAt           DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           PortalTenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project          PortalProject         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy        AdminUser?            @relation("PortalQuotationCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  decisions        PortalQuoteDecision[]
  comments         PortalComment[]

  @@unique([tenantId, number, version])
  @@index([tenantId, status, updatedAt])
  @@index([projectId, status])
}

model PortalQuoteDecision {
  id           String           @id @default(cuid())
  quotationId  String
  membershipId String
  decision     String
  comment      String?          @db.Text
  createdAt    DateTime         @default(now())
  quotation    PortalQuotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  membership   PortalMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([quotationId, createdAt])
  @@index([membershipId, createdAt])
}

model PortalComment {
  id           String           @id @default(cuid())
  tenantId     String
  projectId    String?
  quotationId  String?
  portalUserId String?
  adminUserId  String?
  body         String           @db.Text
  internal     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  tenant       PortalTenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project      PortalProject?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotation    PortalQuotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  portalUser   PortalUser?      @relation("PortalUserComment", fields: [portalUserId], references: [id], onDelete: SetNull)
  adminUser    AdminUser?       @relation("PortalAdminComment", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([projectId, createdAt])
  @@index([quotationId, createdAt])
}

model PortalAuditEvent {
  id           String       @id @default(cuid())
  tenantId     String
  portalUserId String?
  adminUserId  String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  tenant       PortalTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  portalUser   PortalUser?  @relation("PortalUserAudit", fields: [portalUserId], references: [id], onDelete: SetNull)
  adminUser    AdminUser?   @relation("PortalAdminAudit", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([portalUserId, createdAt])
  @@index([adminUserId, createdAt])
}
