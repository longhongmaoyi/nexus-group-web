generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CLOSED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("EDITOR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CmsPage {
  id                 String        @id @default(cuid())
  slug               String        @unique
  pageType           String        @default("STANDARD")
  status             ContentStatus @default(DRAFT)
  labelEn            String
  labelZh            String
  labelFr            String
  seoTitleEn         String
  seoTitleZh         String
  seoTitleFr         String
  seoDescriptionEn   String        @db.Text
  seoDescriptionZh   String        @db.Text
  seoDescriptionFr   String        @db.Text
  publishedSnapshot  Json?
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sections           CmsSection[]

  @@index([status])
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  key       String
  type      String
  position  Int
  enabled   Boolean  @default(true)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
  @@unique([pageId, position])
  @@index([pageId, position])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  sku            String?       @unique
  titleEn        String
  titleZh        String
  titleFr        String
  descriptionEn  String        @db.Text
  descriptionZh  String        @db.Text
  descriptionFr  String        @db.Text
  category       String
  coverImage     String?
  gallery        Json?
  specifications Json?
  featured       Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  titleEn       String
  titleZh       String
  titleFr       String
  summaryEn     String        @db.Text
  summaryZh     String        @db.Text
  summaryFr     String        @db.Text
  industry      String
  country       String?
  region        String?
  coverImage    String?
  gallery       Json?
  concept       Boolean       @default(true)
  featured      Boolean       @default(false)
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model NewsPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  titleEn     String
  titleZh     String
  titleFr     String
  excerptEn   String        @db.Text
  excerptZh   String        @db.Text
  excerptFr   String        @db.Text
  contentEn   String        @db.Text
  contentZh   String        @db.Text
  contentFr   String        @db.Text
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Supplier {
  id             String   @id @default(cuid())
  companyName    String
  contactName    String?
  email          String?
  phone          String?
  country        String?
  productTypes   String?
  certifications String?
  notes          String?  @db.Text
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  country   String?
  interest  String?
  message   String        @db.Text
  locale    String        @default("en")
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
