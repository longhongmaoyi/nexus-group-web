DATABASE_URL="postgresql://nexus:nexus_local_password@localhost:5432/nexus_group?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_SESSION_SECRET="replace-before-production"
ADMIN_EMAIL="admin@nexuslife.ca"
ADMIN_PASSWORD="replace-with-a-unique-12-character-password"
ADMIN_NAME="NEXUS Administrator"

# Phase 2 media uploads remain disabled until a Vercel Blob store is connected.
CMS_MEDIA_UPLOADS_ENABLED="false"
BLOB_READ_WRITE_TOKEN=""

# Phase 3 flags remain off in new environments until migrations and tests pass.
PHASE3_BUSINESS_TOOLS_ENABLED="false"
PHASE3_ADMIN_TOOLS_ENABLED="false"
PHASE3_EMAIL_NOTIFICATIONS_ENABLED="false"
PHASE3_FORM_SECRET=""
PHASE3_ADMIN_NOTIFICATION_EMAIL=""

# Store real SMTP values only in the hosting provider's encrypted environment.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Phase 4 portals remain closed until the additive migration and auth suite pass.
PHASE4_PORTALS_ENABLED="false"
PHASE4_PORTAL_ADMIN_ENABLED="false"
PORTAL_BLOB_READ_WRITE_TOKEN=""
PORTAL_BLOB_STORE_ID=""
PORTAL_BLOB_WEBHOOK_PUBLIC_KEY=""

# Phase 5 operating modules remain off until the additive migration passes.
PHASE5_ADMIN_ENABLED="false"
PHASE5_INTERNAL_NOTIFICATIONS_ENABLED="false"
PHASE5_PUBLIC_COMPLIANCE_ENABLED="false"
PHASE5_AI_REVIEW_ENABLED="false"
