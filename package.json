{
  "name": "nexus-group-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "cms:seed": "node scripts/cms-seed.mjs",
    "cms:media:index": "node scripts/cms-media-index.mjs",
    "cms:phase2:seed": "node scripts/cms-phase2-seed.mjs",
    "phase3:seed": "node scripts/phase3-seed.mjs",
    "test:phase2:routes": "node scripts/test-phase2-routes.mjs",
    "test:phase3:routes": "node scripts/test-phase3-routes.mjs",
    "admin:create": "node scripts/admin-create.mjs",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontpkg/noto-sans-cjk-sc": "^2.4.0",
    "@prisma/client": "6.7.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.5.18",
    "prisma": "6.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
